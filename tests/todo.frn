
str[] tasks

fn renderTasks()
  str html
  int i = 0
  for i; i < tasks.len; i++
    html += format "<li> {tasks[i]} <button onclick='removeTask({i})>x</botton></li>"
  end
  getElementById("list").innerHTML = html
end

fn addTask()
  map taskInput to getElementById("task")
  str text = taskInput.value
  if text == ""
    return
  end
  tasks.push(text)
  taskInput.value = ""
  saveTasks()
  displayTasks()
end

fn removeTask(int i)
  tasks.splice(i, 1)
  saveTasks()
  renderTasks()
end

fn clearAll()
  tasks = []
  saveTasks()
  renderTasks()
end

fn saveTasks()
  localStorage.setItem("tasks", json.str(tasks))
end

fn loadTasks()
  eval r of localStorage.getItem("tasks")
  ? str >> json.parse(r) >> tasks
  ? null >> _
end

loadTasks()
displayTasks()
